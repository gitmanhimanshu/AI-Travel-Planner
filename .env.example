# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------------------

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
HOST=127.0.0.1
PORT=5000

# Database
# Development (default): SQLite file at instance/travel.db
# Production example:    postgresql+psycopg://user:password@localhost:5432/travel
DATABASE_URL=

# AI provider
# ---------------------------------------------------------------------------
# gemini = Google Gemini (has a free tier)  |  claude = Anthropic
# mock   = offline demo, no key needed      |  auto   = detect from key prefix
#
# Free Gemini key: https://aistudio.google.com/apikey  (starts with "AIza")
#
# Leave AI_PROVIDER=auto: with no key the app runs in demo mode, and the
# moment you paste a Gemini key below it switches to Gemini by itself.
AI_PROVIDER=auto
AI_API_KEY=

# Leave empty for the provider default (gemini-2.5-flash / claude-opus-5).
# Other free-tier Gemini options: gemini-2.5-flash-lite, gemini-2.0-flash
AI_MODEL=
AI_TEMPERATURE=0.8
AI_TIMEOUT_SECONDS=240

# Claude only
AI_EFFORT=medium
AI_MAX_TOKENS=32000

# Weather (optional). Empty = key-less Open-Meteo. Set for OpenWeatherMap.
WEATHER_API_KEY=

# Cookies: set to true when serving over HTTPS
SESSION_COOKIE_SECURE=false

# Set to true to log full HTTP requests (including prompts). Debugging only.
VERBOSE_HTTP_LOGS=false
